% Sample bibliography. Replace each entry with your own references; every
% entry here is cited in main.tex. Write titles in title case: the style
% converts them to APA sentence case when the list is printed. Put a web
% address in the url field and a DOI in the doi field.
@article{example,
  author  = {John Doe},
  title   = {Título del Artículo de Ejemplo},
  journal = {Nombre de la Revista},
  year    = {2023},
  volume  = {1},
  number  = {1},
  pages   = {1--10},
  doi     = {10.1000/j.abc},
}

@book{example2,
  author    = {Jane Smith},
  title     = {Título del Libro de Ejemplo},
  publisher = {Editorial de Ejemplo},
  year      = {2022},
  isbn      = {978-3-16-148410-0},
}

@misc{example3,
  author = {{Example Blog}},
  title  = {Título del Artículo de Blog},
  year   = {2023},
